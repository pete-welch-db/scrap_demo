        {
          "widget": {
            "name": "total_scrap_cost_kpi",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "kpi_summary",
                  "fields": [
                    {"name": "total_scrap_cost", "expression": "`total_scrap_cost`"}
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "counter",
              "encodings": {
                "value": {"fieldName": "total_scrap_cost", "displayName": "Total Scrap Cost"}
              },
              "frame": {
                "title": "Total Scrap Cost (YTD)",
                "showTitle": true
              }
            }
          },
          "position": {"x": 0, "y": 0, "width": 2, "height": 2}
        },
        {
          "widget": {
            "name": "total_qty_scrapped_kpi",
