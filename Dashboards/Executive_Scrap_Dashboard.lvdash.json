  "datasets": [
    {
      "name": "kpi_summary",
      "displayName": "KPI Summary",
      "query": "SELECT \n  ROUND(SUM(total_scrap_cost), 0) as total_scrap_cost,\n  SUM(quantity_scrapped) as total_qty_scrapped,\n  COUNT(*) as total_scrap_records,\n  COUNT(DISTINCT part_id) as unique_parts,\n  COUNT(DISTINCT supplier_id) as unique_suppliers\nFROM welch.scrap_demo.scrap_transactions_silver\nWHERE transaction_year = YEAR(CURRENT_DATE())"
    },
    {
      "name": "eight_d_open_summary",
      "displayName": "8D Open Summary",
      "query": "SELECT COUNT(*) as open_8d_count\nFROM welch.scrap_demo.eight_d_reports_silver\nWHERE status NOT IN ('Closed')"
    },
    {
      "name": "monthly_scrap_trend",
      "displayName": "Monthly Scrap Trend",
      "query": "SELECT \n  CONCAT(transaction_year, '-', LPAD(transaction_month, 2, '0')) as year_month,\n  SUM(quantity_scrapped) as total_quantity_scrapped,\n  ROUND(SUM(total_scrap_cost), 2) as total_scrap_cost,\n  COUNT(*) as scrap_records\nFROM welch.scrap_demo.scrap_transactions_silver\nGROUP BY transaction_year, transaction_month\nORDER BY year_month"
    },
    {
      "name": "scrap_by_plant",
      "displayName": "Scrap by Plant",
      "query": "SELECT \n  plant_name_lookup as plant_name,\n  ROUND(SUM(total_scrap_cost), 2) as total_scrap_cost,\n  SUM(quantity_scrapped) as total_qty_scrapped,\n  COUNT(*) as scrap_incidents\nFROM welch.scrap_demo.scrap_transactions_silver\nGROUP BY plant_name_lookup\nORDER BY total_scrap_cost DESC"
    },
    {
      "name": "top_defects",
      "displayName": "Top Defects",
      "query": "SELECT \n  defect_name_lookup as defect_name,\n  defect_category,\n  ROUND(SUM(total_scrap_cost), 2) as total_scrap_cost,\n  SUM(quantity_scrapped) as total_qty_scrapped\nFROM welch.scrap_demo.scrap_transactions_silver\nGROUP BY defect_name_lookup, defect_category\nORDER BY total_scrap_cost DESC\nLIMIT 10"
    },
    {
      "name": "scrap_by_shift",
      "displayName": "Scrap by Shift",
      "query": "SELECT \n  shift_name,\n  SUM(quantity_scrapped) as total_qty_scrapped,\n  ROUND(AVG(quantity_scrapped), 2) as avg_qty_per_incident,\n  COUNT(*) as incidents\nFROM welch.scrap_demo.scrap_transactions_silver\nGROUP BY shift_name"
    },
    {
      "name": "supplier_scrap_correlation",
      "displayName": "Supplier Scrap Correlation",
      "query": "SELECT \n  supplier_name_lookup as supplier_name,\n  supplier_tier_lookup as supplier_tier,\n  ROUND(AVG(supplier_quality_score), 3) as quality_score,\n  ROUND(SUM(total_scrap_cost), 2) as total_scrap_cost,\n  SUM(quantity_scrapped) as total_qty_scrapped\nFROM welch.scrap_demo.scrap_transactions_silver\nGROUP BY supplier_name_lookup, supplier_tier_lookup"
    },
    {
      "name": "eight_d_by_status",
      "displayName": "8D by Status",
      "query": "SELECT \n  status,\n  COUNT(*) as count,\n  ROUND(SUM(total_scrap_cost), 2) as total_scrap_cost\nFROM welch.scrap_demo.eight_d_reports_silver\nGROUP BY status"
    },
    {
      "name": "plant_monthly_trend",
      "displayName": "Plant Monthly Trend",
      "query": "SELECT \n  CONCAT(transaction_year, '-', LPAD(transaction_month, 2, '0')) as year_month,\n  plant_name_lookup as plant_name,\n  ROUND(SUM(total_scrap_cost), 2) as total_scrap_cost\nFROM welch.scrap_demo.scrap_transactions_silver\nGROUP BY transaction_year, transaction_month, plant_name_lookup\nORDER BY year_month, plant_name"
    },
    {
      "name": "plant_defect_matrix",
      "displayName": "Plant Defect Matrix",
      "query": "SELECT \n  plant_name_lookup as plant_name,\n  defect_category,\n  SUM(quantity_scrapped) as total_qty_scrapped\nFROM welch.scrap_demo.scrap_transactions_silver\nGROUP BY plant_name_lookup, defect_category"
    },
    {
      "name": "plant_shift_analysis",
      "displayName": "Plant Shift Analysis",
      "query": "SELECT \n  plant_name_lookup as plant_name,\n  shift_name,\n  SUM(quantity_scrapped) as total_qty_scrapped\nFROM welch.scrap_demo.scrap_transactions_silver\nGROUP BY plant_name_lookup, shift_name"
    },
    {
      "name": "plant_performance_summary",
      "displayName": "Plant Performance Summary",
      "query": "SELECT \n  plant_name_lookup as plant_name,\n  ROUND(SUM(total_scrap_cost), 2) as total_scrap_cost,\n  SUM(quantity_scrapped) as total_qty_scrapped,\n  COUNT(*) as scrap_incidents,\n  COUNT(DISTINCT defect_code) as unique_defects,\n  ROUND(AVG(total_scrap_cost), 2) as avg_cost_per_incident\nFROM welch.scrap_demo.scrap_transactions_silver\nGROUP BY plant_name_lookup\nORDER BY total_scrap_cost DESC"
    },
    {
      "name": "supplier_scorecard",
      "displayName": "Supplier Scorecard",
      "query": "WITH supplier_scrap AS (\n  SELECT \n    supplier_id,\n    supplier_name_lookup as supplier_name,\n    supplier_tier_lookup as supplier_tier,\n    ROUND(AVG(supplier_quality_score), 3) as quality_score,\n    ROUND(SUM(total_scrap_cost), 2) as total_scrap_cost,\n    SUM(quantity_scrapped) as total_qty_scrapped,\n    COUNT(DISTINCT part_id) as parts_affected\n  FROM welch.scrap_demo.scrap_transactions_silver\n  GROUP BY supplier_id, supplier_name_lookup, supplier_tier_lookup\n),\nsupplier_8d AS (\n  SELECT \n    supplier_id,\n    COUNT(*) as eight_d_count\n  FROM welch.scrap_demo.eight_d_reports_silver\n  GROUP BY supplier_id\n)\nSELECT \n  s.supplier_name,\n  s.supplier_tier,\n  s.quality_score,\n  s.total_scrap_cost,\n  s.total_qty_scrapped,\n  s.parts_affected,\n  COALESCE(e.eight_d_count, 0) as eight_d_count,\n  CASE \n    WHEN s.quality_score >= 0.95 THEN 'A - Excellent'\n    WHEN s.quality_score >= 0.90 THEN 'B - Good'\n    WHEN s.quality_score >= 0.80 THEN 'C - Acceptable'\n    ELSE 'D - Needs Improvement'\n  END as performance_tier\nFROM supplier_scrap s\nLEFT JOIN supplier_8d e ON s.supplier_id = e.supplier_id\nORDER BY s.total_scrap_cost DESC"
    },
    {
      "name": "supplier_tier_summary",
      "displayName": "Supplier Tier Summary",
      "query": "SELECT \n  supplier_tier_lookup as supplier_tier,\n  ROUND(SUM(total_scrap_cost), 2) as total_scrap_cost,\n  COUNT(DISTINCT supplier_id) as supplier_count\nFROM welch.scrap_demo.scrap_transactions_silver\nGROUP BY supplier_tier_lookup"
    },
    {
      "name": "top_problem_suppliers",
      "displayName": "Top Problem Suppliers",
      "query": "SELECT \n  supplier_name_lookup as supplier_name,\n  ROUND(SUM(total_scrap_cost), 2) as total_scrap_cost,\n  ROUND(AVG(supplier_quality_score), 3) as quality_score\nFROM welch.scrap_demo.scrap_transactions_silver\nGROUP BY supplier_name_lookup\nORDER BY total_scrap_cost DESC\nLIMIT 10"
    },
    {
      "name": "supplier_monthly_trend",
      "displayName": "Supplier Monthly Trend",
      "query": "SELECT \n  CONCAT(transaction_year, '-', LPAD(transaction_month, 2, '0')) as year_month,\n  supplier_tier_lookup as supplier_tier,\n  ROUND(SUM(total_scrap_cost), 2) as total_scrap_cost\nFROM welch.scrap_demo.scrap_transactions_silver\nGROUP BY transaction_year, transaction_month, supplier_tier_lookup\nORDER BY year_month"
    },
    {
      "name": "eight_d_kpis",
      "displayName": "8D KPIs",
      "query": "SELECT \n  SUM(CASE WHEN status NOT IN ('Closed') THEN 1 ELSE 0 END) as open_count,\n  SUM(CASE WHEN is_overdue = true THEN 1 ELSE 0 END) as overdue_count,\n  SUM(CASE WHEN severity = 'Critical' THEN 1 ELSE 0 END) as critical_count,\n  ROUND(AVG(CASE WHEN status = 'Closed' THEN days_open END), 1) as avg_days_to_close\nFROM welch.scrap_demo.eight_d_reports_silver"
    },
    {
      "name": "eight_d_by_severity",
      "displayName": "8D by Severity",
      "query": "SELECT \n  severity,\n  COUNT(*) as count,\n  ROUND(SUM(total_scrap_cost), 2) as total_scrap_cost\nFROM welch.scrap_demo.eight_d_reports_silver\nGROUP BY severity\nORDER BY \n  CASE severity \n    WHEN 'Critical' THEN 1 \n    WHEN 'Major' THEN 2 \n    WHEN 'Moderate' THEN 3 \n    ELSE 4 \n  END"
    },
    {
      "name": "eight_d_by_root_cause",
      "displayName": "8D by Root Cause",
      "query": "SELECT \n  root_cause_category,\n  COUNT(*) as count\nFROM welch.scrap_demo.eight_d_reports_silver\nGROUP BY root_cause_category\nORDER BY count DESC"
    },
    {
      "name": "eight_d_monthly_trend",
      "displayName": "8D Monthly Trend",
      "query": "SELECT \n  CONCAT(YEAR(date_opened), '-', LPAD(MONTH(date_opened), 2, '0')) as year_month,\n  COUNT(*) as opened_count,\n  SUM(CASE WHEN status = 'Closed' THEN 1 ELSE 0 END) as closed_count\nFROM welch.scrap_demo.eight_d_reports_silver\nGROUP BY YEAR(date_opened), MONTH(date_opened)\nORDER BY year_month"
    },
    {
      "name": "eight_d_open_details",
      "displayName": "8D Open Details",
      "query": "SELECT \n  eight_d_id,\n  title,\n  severity,\n  status,\n  plant_name_lookup as plant_name,\n  days_open,\n  ROUND(total_scrap_cost, 2) as total_scrap_cost,\n  CASE WHEN is_overdue THEN 'Yes' ELSE 'No' END as is_overdue\nFROM welch.scrap_demo.eight_d_reports_silver\nWHERE status NOT IN ('Closed')\nORDER BY \n  CASE severity WHEN 'Critical' THEN 1 WHEN 'Major' THEN 2 ELSE 3 END,\n  days_open DESC\nLIMIT 50"
    }
  ],
  "displayName": "Executive Scrap Dashboard",
  "warehouse_id": ""
}

